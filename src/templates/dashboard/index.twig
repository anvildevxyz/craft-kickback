{# =========================================================================
   Kickback Dashboard
   Overview stats, alerts, commission trend, and recent activity.
   Built from native Craft CP components (.pane, data tables, .status).
   ========================================================================= #}

{% extends '_layouts/cp' %}
{% import 'kickback/_macros/status' as status %}

{% set title = 'Kickback' %}
{% set selectedSubnavItem = 'dashboard' %}

{% set currency = craft.kickback.currency %}

{# ── Muted line icons (currentColor, inherit pane text) ── #}
{% macro iconUsers() %}
<svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
{% endmacro %}
{% macro iconCursor() %}
<svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4l7.07 17 2.51-7.39L21 11.07z"/><path d="M15 15l5 5"/></svg>
{% endmacro %}
{% macro iconShare() %}
<svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
{% endmacro %}
{% macro iconDollar() %}
<svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
{% endmacro %}
{% macro iconClock() %}
<svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
{% endmacro %}

{% block content %}
    {% do view.registerJsFile('https://cdn.jsdelivr.net/npm/chart.js') %}

    <div class="kb-dashboard">

        {# ── Alert banners ───────────────────────────── #}
        {% if pendingCount > 0 or stats.flaggedReferrals > 0 %}
            <div class="kb-alerts">
                {% if pendingCount > 0 %}
                    <div class="pane kb-alert">
                        <span class="status orange"></span>
                        <div class="kb-alert__text">
                            <strong>{{ pendingCount }} {{ 'Pending Affiliate'|t('kickback') }}{{ pendingCount > 1 ? 's' }}</strong>
                            <span>{{ 'Affiliates awaiting your approval.'|t('kickback') }}</span>
                        </div>
                        <a href="{{ cpUrl('kickback/affiliates', { source: 'status:pending' }) }}" class="btn small">{{ 'common.review'|t('kickback') }}</a>
                    </div>
                {% endif %}
                {% if stats.flaggedReferrals > 0 %}
                    <div class="pane kb-alert">
                        <span class="status red"></span>
                        <div class="kb-alert__text">
                            <strong>{{ stats.flaggedReferrals }} {{ 'Flagged Referral'|t('kickback') }}{{ stats.flaggedReferrals > 1 ? 's' }}</strong>
                            <span>{{ 'Fraud detection flagged referrals that need review.'|t('kickback') }}</span>
                        </div>
                        <a href="{{ cpUrl('kickback/fraud') }}" class="btn small">{{ 'common.review'|t('kickback') }}</a>
                    </div>
                {% endif %}
            </div>
        {% endif %}

        {# ── Stat panes ──────────────────────────────── #}
        <div class="kb-stats">
            <a href="{{ cpUrl('kickback/affiliates', { source: 'status:active' }) }}" class="pane kb-stat">
                <div class="kb-stat__head">
                    <span class="kb-stat__label">{{ 'dashboard.activeAffiliates'|t('kickback') }}</span>
                    <span class="kb-stat__icon">{{ _self.iconUsers() }}</span>
                </div>
                <div class="kb-stat__value">{{ stats.activeAffiliates }}</div>
                <div class="kb-stat__sub">{{ stats.totalAffiliates }} {{ 'total'|t('app') }}</div>
            </a>

            <a href="{{ cpUrl('kickback/reports') }}" class="pane kb-stat">
                <div class="kb-stat__head">
                    <span class="kb-stat__label">{{ 'dashboard.totalClicks'|t('kickback') }}</span>
                    <span class="kb-stat__icon">{{ _self.iconCursor() }}</span>
                </div>
                <div class="kb-stat__value">{{ stats.totalClicks|number_format }}</div>
                <div class="kb-stat__sub">{{ stats.conversionRate }}% {{ 'conversion'|t('kickback') }}</div>
            </a>

            <a href="{{ cpUrl('kickback/referrals') }}" class="pane kb-stat">
                <div class="kb-stat__head">
                    <span class="kb-stat__label">{{ 'dashboard.totalReferrals'|t('kickback') }}</span>
                    <span class="kb-stat__icon">{{ _self.iconShare() }}</span>
                </div>
                <div class="kb-stat__value">{{ stats.totalReferrals|number_format }}</div>
            </a>

            <a href="{{ cpUrl('kickback/commissions') }}" class="pane kb-stat">
                <div class="kb-stat__head">
                    <span class="kb-stat__label">{{ 'dashboard.totalCommissions'|t('kickback') }}</span>
                    <span class="kb-stat__icon">{{ _self.iconDollar() }}</span>
                </div>
                <div class="kb-stat__value">{{ stats.totalCommissions|currency(currency) }}</div>
                <div class="kb-stat__sub">{{ stats.approvedCommissions|currency(currency) }} {{ 'approved'|t('kickback') }}</div>
            </a>

            <a href="{{ cpUrl('kickback/commissions', { source: 'status:pending' }) }}" class="pane kb-stat">
                <div class="kb-stat__head">
                    <span class="kb-stat__label">{{ 'dashboard.pendingCommissions'|t('kickback') }}</span>
                    <span class="kb-stat__icon">{{ _self.iconClock() }}</span>
                </div>
                <div class="kb-stat__value">{{ stats.pendingCommissions|currency(currency) }}</div>
            </a>
        </div>

        {# ── Commission trend chart ──────────────────── #}
        <div class="pane">
            <div class="kb-pane-head">
                <h2>{{ 'Commission Trend'|t('kickback') }}</h2>
                <span class="light">{{ 'Last 30 Days'|t('kickback') }}</span>
            </div>
            <div class="kb-chart">
                <canvas id="kb-commissions-chart"></canvas>
            </div>
        </div>

        {% js %}
            (function() {
                var data = {{ dailyCommissions|json_encode|raw }};
                var isDark = document.documentElement.dataset.colorScheme === 'dark';

                var canvas = document.getElementById('kb-commissions-chart');
                var ctx = canvas.getContext('2d');

                var gradient = ctx.createLinearGradient(0, 0, 0, 260);
                gradient.addColorStop(0, isDark ? 'rgba(5, 150, 105, 0.2)' : 'rgba(5, 150, 105, 0.15)');
                gradient.addColorStop(1, 'rgba(5, 150, 105, 0.01)');

                var gridColor = isDark ? 'rgba(255,255,255,0.06)' : 'rgba(0,0,0,0.05)';
                var tickColor = isDark ? 'rgba(255,255,255,0.4)' : 'rgba(0,0,0,0.4)';

                new Chart(canvas, {
                    type: 'line',
                    data: {
                        labels: data.map(function(d) { return d.date; }),
                        datasets: [{
                            label: '{{ "Commissions"|t("kickback") }}',
                            data: data.map(function(d) { return parseFloat(d.total); }),
                            borderColor: '#059669',
                            borderWidth: 2,
                            backgroundColor: gradient,
                            fill: true,
                            tension: 0.35,
                            pointRadius: 0,
                            pointHoverRadius: 5,
                            pointHoverBackgroundColor: '#059669',
                            pointHoverBorderColor: isDark ? '#1e293b' : '#fff',
                            pointHoverBorderWidth: 2,
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: { intersect: false, mode: 'index' },
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                backgroundColor: isDark ? '#334155' : '#1e293b',
                                titleColor: '#e2e8f0',
                                bodyColor: '#e2e8f0',
                                titleFont: { weight: '600', size: 12 },
                                bodyFont: { weight: '500', size: 13 },
                                padding: { x: 12, y: 8 },
                                cornerRadius: 6,
                                displayColors: false,
                                callbacks: {
                                    title: function(ctx) {
                                        var d = new Date(ctx[0].label + 'T00:00:00');
                                        return d.toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
                                    },
                                    label: function(ctx) {
                                        return '{{ currency }} ' + ctx.parsed.y.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                grid: { display: false },
                                border: { display: false },
                                ticks: {
                                    color: tickColor,
                                    font: { size: 10.5 },
                                    maxRotation: 0,
                                    maxTicksLimit: 7,
                                    callback: function(val, i) {
                                        var label = this.getLabelForValue(val);
                                        var d = new Date(label + 'T00:00:00');
                                        return d.toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
                                    }
                                }
                            },
                            y: {
                                beginAtZero: true,
                                border: { display: false },
                                grid: { color: gridColor },
                                ticks: {
                                    color: tickColor,
                                    font: { size: 10.5 },
                                    padding: 8,
                                    maxTicksLimit: 5,
                                    callback: function(value) {
                                        if (value === 0) return '0';
                                        if (value >= 1000) return (value / 1000).toFixed(value % 1000 === 0 ? 0 : 1) + 'k';
                                        return value;
                                    }
                                }
                            }
                        }
                    }
                });
            })();
        {% endjs %}

        {# ── Recent affiliates + recent referrals ────── #}
        <div class="kb-cols">
            <div class="pane">
                <div class="kb-pane-head">
                    <h2>{{ 'dashboard.recentAffiliates'|t('kickback') }}</h2>
                    <a href="{{ cpUrl('kickback/affiliates') }}">{{ 'View all'|t('app') }}</a>
                </div>
                {% if recentAffiliates|length %}
                    <table class="data fullwidth">
                        <thead>
                            <tr>
                                <th>{{ 'common.name'|t('kickback') }}</th>
                                <th>{{ 'common.status'|t('kickback') }}</th>
                                <th class="rightalign">{{ 'affiliate.field.earnings'|t('kickback') }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for affiliate in recentAffiliates %}
                                <tr>
                                    <td>
                                        <a href="{{ affiliate.cpEditUrl }}">{{ affiliate.title }}</a>
                                        <div class="code light">{{ affiliate.referralCode }}</div>
                                    </td>
                                    <td>{{ status.badge(affiliate.affiliateStatus, 'affiliate') }}</td>
                                    <td class="rightalign">{{ affiliate.lifetimeEarnings|currency(currency) }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% else %}
                    <p class="light centeralign" style="padding: 1rem 0;">{{ 'No affiliates yet.'|t('kickback') }}</p>
                {% endif %}
            </div>

            <div class="pane">
                <div class="kb-pane-head">
                    <h2>{{ 'portal.recentReferrals'|t('kickback') }}</h2>
                    <a href="{{ cpUrl('kickback/referrals') }}">{{ 'View all'|t('app') }}</a>
                </div>
                {% if recentReferrals|length %}
                    <table class="data fullwidth">
                        <thead>
                            <tr>
                                <th>{{ 'affiliate.one'|t('kickback') }}</th>
                                <th class="rightalign">{{ 'Subtotal'|t('kickback') }}</th>
                                <th>{{ 'common.status'|t('kickback') }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for referral in recentReferrals %}
                                {% set affiliate = affiliates[referral.affiliateId] ?? null %}
                                <tr>
                                    <td>
                                        {% if affiliate %}
                                            <a href="{{ cpUrl('kickback/affiliates/' ~ affiliate.id) }}">{{ affiliate.title }}</a>
                                        {% else %}
                                            <span class="light">&mdash;</span>
                                        {% endif %}
                                    </td>
                                    <td class="rightalign">{{ referral.orderSubtotal|currency(currency) }}</td>
                                    <td>{{ status.badge(referral.status, 'referral') }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% else %}
                    <p class="light centeralign" style="padding: 1rem 0;">{{ 'portal.emptyReferrals'|t('kickback') }}</p>
                {% endif %}
            </div>
        </div>

        {# ── Recent commissions (full width) ─────────── #}
        <div class="pane">
            <div class="kb-pane-head">
                <h2>{{ 'portal.recentCommissions'|t('kickback') }}</h2>
                <a href="{{ cpUrl('kickback/commissions') }}">{{ 'View all'|t('app') }}</a>
            </div>
            {% if recentCommissions|length %}
                <table class="data fullwidth">
                    <thead>
                        <tr>
                            <th>{{ 'common.id'|t('kickback') }}</th>
                            <th>{{ 'affiliate.one'|t('kickback') }}</th>
                            <th class="rightalign">{{ 'common.amount'|t('kickback') }}</th>
                            <th>{{ 'common.rate'|t('kickback') }}</th>
                            <th>{{ 'Rule'|t('kickback') }}</th>
                            <th>{{ 'common.status'|t('kickback') }}</th>
                            <th>{{ 'common.date'|t('kickback') }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for commission in recentCommissions %}
                            {% set affiliate = affiliates[commission.affiliateId] ?? null %}
                            <tr>
                                <td class="code">#{{ commission.id }}</td>
                                <td>
                                    {% if affiliate %}
                                        <a href="{{ cpUrl('kickback/affiliates/' ~ affiliate.id) }}">{{ affiliate.title }}</a>
                                    {% else %}
                                        <span class="light">&mdash;</span>
                                    {% endif %}
                                </td>
                                <td class="rightalign">{{ commission.amount|currency(commission.currency) }}</td>
                                <td>
                                    {% if commission.rateType == 'percentage' %}
                                        {{ commission.rate }}%
                                    {% else %}
                                        {{ commission.rate|currency(commission.currency) }}
                                    {% endif %}
                                </td>
                                <td>
                                    {% if commission.ruleApplied %}
                                        <span class="code">{{ commission.ruleApplied }}</span>
                                    {% else %}
                                        <span class="light">&mdash;</span>
                                    {% endif %}
                                </td>
                                <td>{{ status.badge(commission.status, 'commission') }}</td>
                                <td class="light">{{ commission.dateCreated|date('short') }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% else %}
                <p class="light centeralign" style="padding: 1rem 0;">{{ 'portal.emptyCommissions'|t('kickback') }}</p>
            {% endif %}
        </div>

    </div>

    {# Layout-only glue. All colour/surface comes from native .pane + Craft tokens. #}
    {% css %}
        /* Craft zeroes .pane:first-child margin-top and .pane:last-child margin-bottom
           with !important; inside a grid that makes the edge panes taller. Neutralise
           all pane margins here and let grid gap / explicit rhythm own the spacing. */
        .kb-dashboard .pane { margin: 0; }
        .kb-dashboard > .pane { margin-bottom: 14px; }
        .kb-dashboard > .pane:last-child { margin-bottom: 0; }
        .kb-dashboard .kb-alerts { display: flex; flex-direction: column; gap: 10px; margin-bottom: 18px; }
        .kb-dashboard .kb-alert { display: flex; align-items: center; gap: 12px; }
        .kb-dashboard .kb-alert .status { margin: 0; flex: 0 0 auto; }
        .kb-dashboard .kb-alert__text { flex: 1 1 auto; }
        .kb-dashboard .kb-alert__text strong { display: block; }
        .kb-dashboard .kb-alert__text span { color: var(--medium-text-color); font-size: 13px; }
        .kb-dashboard .kb-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
            gap: 14px;
            margin-bottom: 14px;
        }
        .kb-dashboard a.kb-stat { display: block; text-decoration: none; color: var(--text-color); transition: border-color .15s ease, box-shadow .15s ease; }
        .kb-dashboard a.kb-stat:hover { border-color: var(--link-color); box-shadow: var(--pane-shadow); }
        .kb-dashboard .kb-stat__head { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 10px; }
        .kb-dashboard .kb-stat__label { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .04em; color: var(--medium-text-color); }
        .kb-dashboard .kb-stat__icon { display: inline-flex; color: var(--light-text-color); }
        .kb-dashboard .kb-stat__value { font-size: 28px; font-weight: 600; line-height: 1.1; }
        .kb-dashboard .kb-stat__sub { margin-top: 5px; font-size: 12px; color: var(--medium-text-color); }
        .kb-dashboard .kb-pane-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
        .kb-dashboard .kb-pane-head h2 { margin: 0; }
        .kb-dashboard .kb-chart { position: relative; height: 260px; }
        .kb-dashboard .kb-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 14px; }
        @media (max-width: 900px) { .kb-dashboard .kb-cols { grid-template-columns: 1fr; } }
    {% endcss %}
{% endblock %}
